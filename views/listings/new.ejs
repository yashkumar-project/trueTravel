<% layout('layouts/boilerplate') %>

    <!-- <link rel="stylesheet" href="/listing css/new.css"> -->

<body>
    <h1>Create your new listing</h1>

    <form action="/listings" method="POST">
        <div>
            <label for="title">Title</label>
            <input type="text" id="title" name="listing[title]" placeholder="Listing title" required>
        </div>
<br>
        <div>
            <label for="description">Description</label>
            <textarea id="description" name="listing[description]" placeholder="Describe your listing" required></textarea>
        </div>
<br>
        <div>
            <label for="location">Address</label>
            <input type="text" id="location" name="listing[location]" placeholder="Location" required>
        </div>
<br>
        <div>
            <label for="country">Country</label>
            <input type="text" id="country" name="listing[country]" placeholder="Country" required>
        </div>
<br>
        <div>
            <label for="price">Price</label>
            <input type="number" id="price" name="listing[price]" placeholder="Price" min="0" required>
        </div>
<br>
        <div>
            <label for="imageUrl">Image URL</label>
            <input type="url" id="imageUrl" name="listing[image][url]" placeholder="Image URL">
        </div>
<br>
        <div id="button">
            <button type="submit" class="btn btn-primary">Create Listing</button>
            <a href="/listings" class="btn btn-outline-danger">Cancel</a>
        </div>
</body>
