<% layout('layouts/boilerplate') %>

    <body>
        <p>You are going to edit</p>
        <h2>
            <%= destination.title %>
        </h2>

        <form method="POST" action="/listings/<%= destination._id %>?_method=PUT" 
        enctype="multipart/form-data">
            <div>
                <label for="title">Title</label>
                <input type="text" id="title" name="listing[title]" value="<%= destination.title %>" required>
            </div>

            <div>
                <label for="description">Description</label>
                <textarea id="description" name="listing[description]"
                    required><%= destination.description %></textarea>
            </div>

            <div>
                <label for="location">Location</label>
                <input type="text" id="location" name="listing[location]" value="<%= destination.location %>" required>
            </div>

            <div>
                <label for="price">Price</label>
                <input type="number" id="price" name="listing[price]" value="<%= destination.price %>" required>
            </div>

            <div>
                <label for="country">Country</label>
                <input type="text" id="country" name="listing[country]" value="<%= destination.country %>" required>
            </div>
            <div class="imageEdit mt-3 mb-3">
                <img src="<%= originalUrl %>" style="height: 200px; object-fit: cover;" alt="">
            </div>
            <div>
                <label for="image">Upload New Image Link</label>
                <input type="file" id="image" name="listing[image]" >
            </div>

            <button type="submit">Update Listing</button>
        </form>

    </body>