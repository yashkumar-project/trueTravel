<% layout('layouts/boilerplate') %>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
  }

  .filter {
    margin-left: 0.7rem;
    text-align: center;
    opacity: 0.75;
  }

  .filter:hover {
    opacity: 1;
    color: #06bcf9;
    cursor: pointer;
  }
</style>

  <body>
    <div class="container py-2">
     <div class="filters">
      <div class="filter">
        <div class="filterIcon"><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </div>
      <div class="filter">
        <div class="filterIcon"><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </div>
