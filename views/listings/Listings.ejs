<% layout('layouts/boilerplate') %>

<body>
  <br>
<a href="/listings/new" class=""><button type="button" class="btn btn-outline-info ">Add new listing </button></a>

<% for( let list of Listings){ %>
<div class="card mt-3" style="width: 18rem;">
  <img src="<%= list.image.url %>" class="card-img-top" alt="..">
  <div class="card-body">
    <p class="card-text"><a style="text-decoration: none; color: black;" href="/listings/<%= list._id%>"><%= list.title %></a></p>
  </div>
</div>
<br>
<% } %>
</body>


