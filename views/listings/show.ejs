<% layout('layouts/boilerplate') %>

<body>
    <h2>Welcomen to <%=destination.title%></h2>
    <img src="<%=destination.image.url%>" alt="<%=destination.title%>">
    <br>
    <p><%= destination.description%></p>
    <br>
    <h3>location is <%=destination.location%></h3>
    <h3>country: <%=destination.country%></h3>
    <p><b>Price:  &#8377 <%=destination.price.toLocaleString("en-IN")%></b></p>

    <a href="/listings/<%=destination._id%>/edit"><button>Edit</button></a>
    <br><br>
    <form method="POST" action="/listings/<%= destination._id%>?_method=DELETE">
        <button>Delete This Post</button>
    </form>
</body>
